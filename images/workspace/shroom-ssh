#!/bin/sh
set -eu
umask 077

case "${1:-}" in
    provision)
        # Creation is deliberately one-shot, including after partial failure.
        test ! -e /etc/ssh/ssh_host_ed25519_key
        test ! -e /etc/ssh/ssh_host_ed25519_key.pub
        test ! -e /etc/shroom/authorized_keys
        test ! -e /etc/sudoers.d/shroom-workspace
        user=${2:?guest username is required}
        case "$user" in
            ''|root|[!a-z]*|*[!a-z0-9_-]*) echo 'invalid guest username' >&2; exit 2 ;;
        esac
        test "${#user}" -le 32
        test "$(id -u developer)" = 1000
        test "$(id -g developer)" = 1000
        if ! command -v sudo >/dev/null || test ! -x /usr/sbin/visudo; then
            echo 'workspace image is missing sudo; rebuild and reimport it' >&2
            exit 2
        fi
        if [ "$user" != developer ]; then
            if getent passwd "$user" >/dev/null || getent group "$user" >/dev/null; then
                echo 'guest username already exists in the image' >&2
                exit 2
            fi
            usermod --login "$user" --home "/home/$user" --move-home developer
            groupmod --new-name "$user" developer
        fi
        printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$user" > /etc/sudoers.d/shroom-workspace
        chown root:root /etc/sudoers.d/shroom-workspace
        chmod 0440 /etc/sudoers.d/shroom-workspace
        /usr/sbin/visudo -c
        sed -i "s/^AllowUsers .*/AllowUsers $user/" /etc/ssh/sshd_config
        IFS= read -r client_key
        printf '%s\n' "$client_key" > /etc/shroom/authorized_keys
        chmod 0644 /etc/shroom/authorized_keys
        ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/ssh_host_ed25519_key
        ;;
    start)
        # Missing identities require explicit removal and recreation.
        test -s /etc/ssh/ssh_host_ed25519_key
        test -s /etc/ssh/ssh_host_ed25519_key.pub
        test -s /etc/shroom/authorized_keys
        ;;
    *) exit 2 ;;
esac

install -d -m 0755 /run/sshd
/usr/sbin/sshd -f /etc/ssh/sshd_config </dev/null >/dev/null 2>&1
